# hibrid48 weights + myllmbox cluster-kit v4 settings (docs/09-optimizations.md).
# Qwen3.8-Flash-Next NVFP4 (nvidia) on 2x DGX Spark, TP2 + EP + MTP3.
# Port of MiaAI-Lab/Qwen3.8-Flash-Next-Dual-DGX-Sparks "v0.30 lane" (start-v030.sh)
# at the commit pinned in fetch-recipe.sh. Stock vllm/vllm-openai:v0.30.0 plus one
# overlay (reduced MTP draft vocabulary). BF16 KV (lane default), GMU 0.80.
MODEL_DIR=/root/.cache/huggingface/hub/models--myllmbox--Qwen3.8-Flash-Next-hibrid48/snapshots/e316057ddc794cbf76c3ef28bfd1c7b62b20128c
SERVED_MODEL_NAME=qwen3.8-flash-next
PORT=8888
HEAD_IP=10.100.0.10
MASTER_PORT=29531
TP=2
ENABLE_EXPERT_PARALLEL=false
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEM_UTIL=0.70
KV_CACHE_DTYPE=auto
MAMBA_SSM_CACHE_DTYPE=bfloat16
MM_ENCODER_TP_MODE=data
MTP_TOKENS=5
MTP_DISABLE_BLOCK_DROP=1
MTP_INDEX_SHARE=true
MTP_DRAFT_VOCAB=
EVICT_PAGE_CACHE=true
EXTRA_ARGS=
# Tuning knobs (empty = vLLM default). Results in docs/08-benchmarks.md.
MOE_BACKEND=marlin
BLOCK_SIZE=1632
MTP_DRAFT_SAMPLE=probabilistic
MTP_REJECTION=block
MBX_PATCHES=03 05 11 18
ENGRAM_CONFIG={"cpu_offload": false}
KV_CACHE_MEMORY=36000000000
MBX_FUSED_DRAFT=1
MBX_PLE_REPLICATE=0
COMPILATION_CONFIG={"cudagraph_mode":"FULL_AND_PIECEWISE","cudagraph_capture_sizes":[1,2,4,6,8,12,16,18,24,30,36,42,48],"compile_ranges_endpoints":[32]}
GDN_PREFILL_BACKEND=triton
ASYNC_SCHEDULING=true
HF_HOME=/root/.cache/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_FLASHINFER_AUTOTUNE_CACHE_DIR=/tmp/fi_autotune
GLOO_SOCKET_IFNAME=enp1s0f0np0
NCCL_SOCKET_IFNAME=enp1s0f0np0
TP_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_DISABLE=0
NCCL_IB_HCA=mlx5_0
NCCL_IB_GID_INDEX=3
NCCL_IB_AUTO_DETECT=0
NCCL_DEBUG=WARN
NCCL_MAX_NCHANNELS=4
VLLM_MARLIN_USE_ATOMIC_ADD=1
