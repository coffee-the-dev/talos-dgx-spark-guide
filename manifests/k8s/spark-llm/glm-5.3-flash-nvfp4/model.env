# mmastrac/glm-5.3-flash-4x-gx10 at TP=2. The image's entrypoint owns every
# tuned default; set only what differs on this cluster.
TP=2
HEAD_HOST=10.0.0.20
# Both ConnectX-7 PCIe roots (10.100.0.x on enp1s0f0np0, 10.101.0.x on
# enP2p1s0f0np0). The entrypoint maps each to its RDMA device and GID.
FABRIC_SUBNETS=10.100.0. 10.101.0.
API_PORT=8888
STATUS_PORT=8082
SERVICE_NAME=glm53
SERVED_NAME=GLM-5.3-Flash-NVFP4
CONTAINER_NAME=glm53
MODEL_DIR=/hf/hub/models--nvidia--GLM-5.3-Flash-NVFP4/snapshots/09b04e5e74bca08ca8549fc736d4cdd8624bfde3
DFLASH_MODEL=/hf/hub/models--incoai--GLM-5.3-Flash-DFlash2/snapshots/dc77ff1c99eeb2df044ee3d4f0094eb033fee410
# KV pin, context and batch budget come from the image's TP=2 defaults
# (6db84d4: 8 GiB KV, 163840 ctx, 8192 batched tokens -- the smaller batch
# budget is what keeps 8 GiB from OOMing in prefill). Do not override one
# without the others.
# eager staged each shard through anonymous memory and both ranks were
# OOM-killed mid-load on Talos (MemFree < 1 GiB, 2026-09-28). lazy mmaps the
# shards, so the staging is reclaimable page cache. Slower load (690 s vs 511 s).
SAFETENSORS_LOAD_STRATEGY=lazy
MCP_LOG_DIR=/logs
TORCH_MEM_STATS_DIR=/logs
THROUGHPUT_INTERVAL_S=60

# --- experimental/ overrides (mmastrac 2288993), stacked in the README's order:
# arx snapshot adaptive-k fp8 megamoe fixes sp recoverssm. Values are the compose defaults; the drafter path is ours.
VLLM_ARX_ALLREDUCE=1
VLLM_ARXBIG=1
VLLM_ARXBIG_RS=1
VLLM_ARXBIG_AG=0
VLLM_WEIGHT_SNAPSHOT_DIR=/root/.cache/weight-snapshots
VLLM_WEIGHT_SNAPSHOT_TAG=w4all-2026-09-29
EXTRA_ARGS=--scheduler-cls vllm.v1.core.sched.adaptive_k.AdaptiveKScheduler --speculative-config {"method":"dflash","model":"/hf/hub/models--incoai--GLM-5.3-Flash-DFlash2/snapshots/dc77ff1c99eeb2df044ee3d4f0094eb033fee410","num_speculative_tokens":7,"attention_backend":"TRITON_ATTN","num_speculative_tokens_per_batch_size":[[1,1,7],[2,2,5],[3,3,4],[4,4,3],[5,5,2],[6,32,7]]}
VLLM_ADAPTIVE_K_CONTROL=/root/.cache/adaptive-k
VLLM_ADAPTIVE_K_COST_MS=2:29.7,3:33.1,4:36.5,5:39.8,6:43.1,7:46.0,8:48.9
VLLM_DENSE_FP8=1
VLLM_DENSE_FP8_LM_HEAD=1
VLLM_DENSE_W4=.
VLLM_MEGAMOE=1
VLLM_MEGAMOE_MAX_TOKENS=8
VLLM_MEGAMOE_VARIANT=20
VLLM_MOE_PREFILL=1
VLLM_MOE_PREFILL_MIN_TOKENS=1024
VLLM_MOE_PREFILL_CHECK=0
VLLM_MOE_PREFILL_Y8=1
VLLM_MHC_FUSED_MAX_TOKENS=32
VLLM_TRITON_SPARSE_MLA=1
VLLM_GLM5NEXT_DRAFT_POOL=1
VLLM_GLM_SP_TP=1
VLLM_GLM_SP_MIN_TOKENS=1024
VLLM_GLM_SP_FP8_GATHER=1
VLLM_GLM_ARX_PREFETCH=1
VLLM_GLM_SP_MOE_FUSED=1
VLLM_GLM_SP_MOE_QUANT_GATHER=1
VLLM_GLM_SP_MOE_CHECK=0
VLLM_GLM5NEXT_RECOVERSSM=1
NCCL_MAX_NCHANNELS=4
